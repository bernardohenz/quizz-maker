# Copie para .env e preencha: cp .env.example .env

# Groq - para gerar perguntas com IA (obtenha em console.groq.com)
GROQ_API_KEY=sua_chave_groq

# Supabase - para produção (obtenha em supabase.com)
# Deixe em branco para usar arquivos locais (quiz_jsons/)
SUPABASE_URL=
SUPABASE_KEY=

# Chave secreta do Supabase, só neste servidor. Não é a chave anon/public.
# Em Project Settings → API Keys, crie uma secret key (sb_secret_...) ou copie a service_role.
# Ela grava o banco de questões sem abrir a tabela para a internet. Não commite e não cole no chat.
SUPABASE_SECRET_KEY=

# Modelo visual para ler a foto da questão. O padrão é qwen/qwen3.8-27b.
GROQ_VISION_MODEL=

# Busca por tipo de questão. Sem URL e chave, o servidor usa um modelo local
# e grava o vetor na coluna de 1536 dimensões. EMBEDDING_LOCAL=0 desliga o modelo local.
# EMBEDDING_API_URL é o endpoint completo, compatível com /v1/embeddings da OpenAI.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_LOCAL=
