# Copie para .env e preencha: cp .env.example .env

# Groq - para gerar perguntas com IA (obtenha em console.groq.com)
GROQ_API_KEY=sua_chave_groq

# Supabase - para produção (obtenha em supabase.com)
# Deixe em branco para usar arquivos locais (quiz_jsons/)
SUPABASE_URL=
SUPABASE_KEY=

# Modelo visual para ler a foto da questão. O padrão é qwen/qwen3.8-27b.
GROQ_VISION_MODEL=

# Embeddings da nota do professor. Sem estas variáveis, a busca usa só os filtros.
# EMBEDDING_API_URL é o endpoint completo, compatível com /v1/embeddings da OpenAI.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
